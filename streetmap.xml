	<!-- ============================================================ -->
	<!-- Кнопка сворачивания: уменьшена до 40×40 (как pano_toggle),    -->
	<!-- добавлена мобильная версия 34×34                              -->
	<!-- ============================================================ -->
	<layer name="street_map_toggle"
		type="text"
		align="bottom" edge="bottom"
		x="0"
		y="273"
		y.mobile="168"
		width="40" height="40"
		width.mobile="34" height.mobile="34"
		bgcolor="0xF5B400" bgalpha="0.95"
		bgborder="1 0xFFFFFF 0.3"
		bgroundedge="20"
		bgroundedge.mobile="17"
		bgshadow="0 3 10 0x000000 0.5"
		css="color:#1A2320; font-family:Arial; font-size:18px; font-weight:bold; text-align:center;"
		vcenter="true"
		html="▼"
		keep="true"
		zorder="110"
		bgcapture="true"
		onclick="toggle_street_map_container();"
		onover="tween(scale,1.08,0.12);"
		onout="tween(scale,1.0,0.12);"
		/>

	<!-- Стиль точек -->
	<style name="street_mapspot"
		type="container"
		width="8"
		height="8"
		bgalpha="1"
		bgroundedge="15"
		bgborder="2 0xFF0000 1"
		bgcolor="0xFFFFFFFF"
		bgshadow="0 0 10 3 0x000000 0.25"
		align="lefttop"
		edge="center"
		enabled="true"
		bgcapture="true"
	/>

    <!-- Действия для управления картами -->
    <action name="update_street_radar">
        set(layer[activespot_street].parent, %1);
        set(plugin[radar_street].parent, %1);
        set(layer[activespot_street].visible, true);
        set(plugin[radar_street].visible, true);
        tween(plugin[radar_street].heading, %2);
    </action>

	<!-- Сворачивание/разворачивание карты -->
	<action name="toggle_street_map_container">
		if(layer[street_map_wrapper].state == 'open',
			<!-- СКРЫТЬ: карта вместе с золотой подложкой уезжает вниз -->
			set(layer[street_map_wrapper].state, 'closed');

			tween(layer[street_map_container].alpha, 0, 0.35, easeInQuad);
			tween(layer[street_map_container].y, 280, 0.35, easeInQuad,
				set(layer[street_map_container].visible, false));

			set(layer[street_map_toggle].html, '▲');
			tween(layer[street_map_toggle].y, 20, 0.35, easeInQuad);
		,
			<!-- ПОКАЗАТЬ: карта вместе с золотой подложкой возвращается -->
			set(layer[street_map_wrapper].state, 'open');

			set(layer[street_map_container].visible, true);
			set(layer[street_map_container].alpha, 0);
			set(layer[street_map_container].y, 280);
			tween(layer[street_map_container].alpha, 1, 0.35, easeOutQuad);
			tween(layer[street_map_container].y, 0, 0.35, easeOutQuad);

			set(layer[street_map_toggle].html, '▼');
			if(device.mobile,
				tween(layer[street_map_toggle].y, 168, 0.35, easeOutQuad);
			,
				tween(layer[street_map_toggle].y, 273, 0.35, easeOutQuad);
			);
		);
	</action>

	<!-- Увеличение/уменьшение карты -->
	<action name="toggle_street_map_size">
		set(state, get(layer[street_map_wrapper].state));

		if(get(state) == minimized,
			if(device.mobile,
				tween(layer[street_map_wrapper].scale, 0.85);
				,
				tween(layer[street_map_wrapper].scale, 1.5);
			);
			set(layer[street_map_wrapper].state, maximized);
			,
			if(device.mobile,
				tween(layer[street_map_wrapper].scale, 0.45);
				,
				tween(layer[street_map_wrapper].scale, 1);
			);
			set(layer[street_map_wrapper].state, minimized);
		);
	</action>

    <action name="update_map_visibility" scope="local">
        if(xml.scene == null, break(); );
        if(scene[get(xml.scene)].category == null, break(); );

        if(scene[get(xml.scene)].category == 'street',
            set(plugin[radar_street].visible, true);
            set(layer[activespot_street].visible, true);
        ,
            set(plugin[radar_street].visible, false);
            set(layer[activespot_street].visible, false);
        );
    </action>

    <action name="switch_to_floor_map">
        set(layer[street_map_wrapper].visible, false);
        set(layer[street_map_toggle].visible, false);
        set(layer[floorplans_container].visible, true);
        set(plugin[street_radar].visible, false);
        set(plugin[radar].visible, true);
        update_floor_buttons();
    </action>

    <action name="show_under_construction">
        addlayer(under_construction_msg);
        set(layer[under_construction_msg], type=text,
            html='<b>В разработке</b>',
            css='color:#FFFFFF; font-family:Arial; font-size:20px; text-align:center;',
            bgcolor=0x000000, bgalpha=0.7,
            align=center, width=300, height=80,
            bgroundedge=20, bgborder='2 0xFFFFFF 0.5',
            onloaded='delayedcall(2.0, removelayer(get(name));)'
        );
    </action>

</krpano>