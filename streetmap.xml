			<plugin name="radar_street"
				keep="true"
	        	visible="false"
				url.html5="plugins/radar.js"
				align="center"
				edge="center"
				x="0" y="0"
				scale="0.2"
				heading="0.0"
				headingoffset="0.0"
				fillcolor="0x45bfe3"
				fillalpha="0.5"
				linewidth="0.0"
				linecolor="0xFFFFFFFF"
				linealpha="0.3"
				invert="false"
			/>

			<layer name="activespot_street"
				keep="true"
	        	visible="false"
				type="container"
				width="15"
				height="15"
				bgalpha="1"
				bgroundedge="15"
				bgborder="2 0x45bfe3 1"
				bgcolor="0x45bfe3"
				bgshadow="0 0 10 3 0x000000 0.25"
				align="center"
				edge="center"
				enabled="true"
				x="0" y="0"
